# Documentation only; tests do not auto-load .env files.
# Inject secrets securely into the process; never commit populated files.
SEPOLIA_RPC_URL=
# Public address for the read-only preflight estimate; no key needed there.
CIPHERQUIZ_OPERATOR_ADDRESS=0xbE4a3DAABCd4406e75314aC7324411249E0C36a2
CIPHERQUIZ_SEPOLIA_ADDRESS=0x4b4c204d28D5ee37896278C5fc56d61086f92b53
CIPHERQUIZ_OPERATOR_PRIVATE_KEY=
# Copy the separate test player's public address independently from its wallet UI.
CIPHERQUIZ_PLAYER_ADDRESS=
CIPHERQUIZ_PLAYER_PRIVATE_KEY=
CIPHERQUIZ_MAX_FEE_PER_GAS_WEI=
CIPHERQUIZ_MAX_TOTAL_GAS_COST_WEI=
# Per-run limit; shared lifetime cap is 20000000000000000 wei.
# Never delete/reset contracts/.sepolia-budget.jsonl* to retry a failed write.
# Leave unset until a live test against the approved deployment is authorized.
CIPHERQUIZ_SEPOLIA_TEST=
