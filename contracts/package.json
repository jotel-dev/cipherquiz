{
  "name": "@cipherquiz/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test",
    "lint": "solhint \"src/**/*.sol\" --max-warnings 0",
    "node": "hardhat node",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.ts --network sepolia",
    "verify:sepolia-signer": "ts-node scripts/verify-sepolia-signer.ts"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@types/mocha": "^10.0.10",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "ethers": "^6.16.0",
    "hardhat": "2.28.6",
    "solhint": "^6.2.1",
    "ts-node": "10.9.2"
  }
}
